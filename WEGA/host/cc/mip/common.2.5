int tbytes(TWORD t)
{ /* the size of a scalar type in bytes, at most 4 */
	switch( t ){
	case LONG:
	case ULONG:
		return( 4 );
	case CHAR:
	case UCHAR:
		return( 1 );
	case SHORT:
	case USHORT:
		return( 2 );
		}
#ifdef SEG
	if( ISPTR(t) ) return( 4 );
#else
	if( ISPTR(t) ) return( 2 );
#endif
	return( 2 );
	}

