void mkdope(void)
{
	register struct dopest *q;

	for( q = indope; q->dopeop >= 0; ++q ){
		dope[q->dopeop] = q->dopeval;
		opst[q->dopeop] = q->opst;
		}
	}

int bsize(int t)
{ /* the size of a scalar type in bits */
	switch( t ){
	case CHAR:
	case UCHAR:
		return( 8 );
	case INT:
	case UNSIGNED:
		return( 16 );
	case LONG:
	case FLOAT:
	case ULONG:
		return( 32 );
	case DOUBLE:
		return( 64 );
		}
#ifdef SEG
	if( ISPTR(t) ) return( 32 );
#else
	if( ISPTR(t) ) return( 16 );
#endif
	cerror( "illegal bsize type: %%%x\n", t );
	}

int szty(TWORD t)
{ /* the size of a scalar type in words */
	switch( t ){
	case LONG:
	case FLOAT:
	case ULONG:
		return( 2 );
	case DOUBLE:
		return( 4 );
	case INT:
	case ENUMTY:
	case UNSIGNED:
		return( 1 );
		}
#ifdef SEG
	if( ISPTR(t) ) return( 2 );
#else
	if( ISPTR(t) ) return( 1 );
#endif
	return( 1 );
	}

