int ispow2(long c)	/* a long of the host, as tn.lval of codgen */
# else
int ispow2(CONSZ c)
# endif
{
	int i;
	if( c <= 0 || (c&(c-1)) ) return(-1);
	for( i=0; c>1; ++i ) c >>= 1;
	return(i);
	}

