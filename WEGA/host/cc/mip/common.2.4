int nerrors = 0;  /* number of errors */
static NODE nodinit;	/* talloc gives a node cleared with it */

void uerror(char *s, ...)
{
	va_list ap;
 /* nonfatal error message */
	/* the routine where is different for pass 1 and pass 2;
	    it tells where the error took place */

	++nerrors;
	where('u');
	va_start( ap, s );
	vfprintf( stderr, s, ap );
	va_end( ap );
	fprintf( stderr, "\n" );
	if( nerrors > 30 ) cerror( "too many errors");
	}

	/* VARARGS1 */
void cerror(char *s, ...)
{ /* compiler error: die */
	va_list ap;

	where('c');
	if( nerrors && nerrors <= 30 ){ /* give the compiler the benefit of the doubt */
		fprintf( stderr, "cannot recover from earlier errors\n" );
		}
	else {
		fprintf( stderr, "compiler error: " );
		va_start( ap, s );
		vfprintf( stderr, s, ap );
		va_end( ap );
		putc( '\n', stderr );
		}
	dexit( 64 );
	}

	/* VARARGS1 */
int werror(char *s, ...)
{  /* warning */
	va_list ap;

	where('w');
	fprintf( stderr, "warning: " );
	va_start( ap, s );
	vfprintf( stderr, s, ap );
	va_end( ap );
	fprintf( stderr, "\n" );
	return 0;
	}

void tinit(void)
{ /* initialize expression tree search */

	NODE *p;

	for( p=node; p<= &node[TREESZ-1]; ++p ) p->in.op = FREE;
	lastfree = node;

	}

# define TNEXT(p) (p== &node[TREESZ-1]?node:p+1)

NODE *talloc(void)
{
	NODE *p, *q;

	q = lastfree;
	for( p = TNEXT(q); p!=q; p= TNEXT(p))
		if( p->in.op ==FREE ){
			*p = nodinit;
			return(lastfree=p);
			}
	q = lastfree;
	for( p = TNEXT(q); p!=q; p= TNEXT(p))
		printf( "talloc: opcode = %d\n", p->in.op );

	cerror( "out of tree space; simplify expression");
	/* NOTREACHED */
	}

void tcheck(void)
{ /* ensure that all nodes have been freed */

	NODE *p;

	if( !nerrors )
		for( p=node; p<= &node[TREESZ-1]; ++p )
			if( p->in.op != FREE ) cerror( "wasted space: %%%x(%d)", p, p->in.op );
	tinit();
	}
void tfree(NODE *p)
{
	/* free the tree p */
	if( p->in.op != FREE ) walkf( p, tfree1 );

	}

void tfree1(NODE *p)
{
	if( p == 0 ) cerror( " freeing blank tree!");
	else p->in.op = FREE;
	}

void fwalk( NODE *t, void (*f)(), int down )	/* (host gopt: f unprototyped) */
{

	int down1, down2;

	more:
	down1 = down2 = 0;

	(*f)( t, down, &down1, &down2 );

	switch( optype( t->in.op ) ){

	case BITYPE:
		fwalk( t->in.left, f, down1 );
		t = t->in.right;
		down = down2;
		goto more;

	case UTYPE:
		t = t->in.left;
		down = down1;
		goto more;

		}
	}

void walkf( NODE *t, void (*f)() )
{
	int opty;

	if( t == 0 ) return;
	opty = optype(t->in.op);

	if( opty != LTYPE ) walkf( t->in.left, f );
	if( opty == BITYPE ) walkf( t->in.right, f );
	(*f)( t );
	}




