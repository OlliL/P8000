int bsize(int t)
{ /* the size of a scalar type in bits */
	switch( t ){
	case CHAR:
	case UCHAR:
		return( 8 );
	case INT:
	case UNSIGNED:
		return( 16 );
	case LONG:
	case FLOAT:
	case ULONG:
		return( 32 );
	case DOUBLE:
		return( 64 );
		}
#ifdef SEG
	if( ISPTR(t) ) return( 32 );
#else
	if( ISPTR(t) ) return( 16 );
#endif
	cerror( "illegal bsize type: %%%x\n", t );
	}

int szty(TWORD t)
{ /* the size of a scalar type in words */
	switch( t ){
	case LONG:
	case FLOAT:
	case ULONG:
		return( SZLONG/SZINT );
	case DOUBLE:
		return( SZDOUBLE/SZINT );
		}
	if( ISPTR(t) ) return( SZPOINT/SZINT );
	return( 1 );
	}

int argsize(NODE *p)
{ /* the size of an argument in words */
	int t;

	if( p->in.op == STARG ) return( p->stn.stsize / 2 );
	if( p->in.op == NAME && p->in.type == STRTY ) return( p->in.sname->ssize / 16 );
	t = szty( p->in.type == FLOAT ? DOUBLE : p->in.type );
	return( t );
	}

