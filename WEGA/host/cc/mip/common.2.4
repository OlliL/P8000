void mkdope(void)
{
	register struct dopest *q;

	for( q = indope; q->dopeop >= 0; ++q ){
		dope[q->dopeop] = q->dopeval;
		opst[q->dopeop] = q->opst;
		}
	}

void tprint(TWORD t, FILE *fp)
{ /* output a nice description of the type of t */

	static char * tnames[] = {
		"undef", "farg", "char", "short", "int", "long", "float", "double", "strty", "unionty", "enumty", "moety",
		"uchar", "ushort", "unsigned", "ulong", "?", "?"
		};

	for(;; t = DECREF(t) ){

		if( ISPTR(t) ) fprintf( fp, "PTR " );
		else if( ISFTN(t) ) fprintf( fp, "FTN " );
		else if( ISARY(t) ) fprintf( fp, "ARY " );
		else {
			if( t > 17 ) t = 17;
			fputs( tnames[t], fp );
			return;
			}
		}
	}

