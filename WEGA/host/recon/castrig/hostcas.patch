+/* test: the early optimization of the old cas at given jpr/callr of the module (ordinal, file CAS_TRIGFILE: name ordinal ...) */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+char *trigname;
+static int trigs[16], ntrig = -1, ordn;
+void
+trigcheck(void)
+{
+	int i;
+	unsigned k;
+	struct sym *sp;
+	extern unsigned stoff;
+
+	if (ntrig < 0) {
+		FILE *f;
+		char nm[80], line[400], *t;
+
+		ntrig = 0;
+		f = getenv("CAS_TRIGFILE") ? fopen(getenv("CAS_TRIGFILE"), "r") : 0;
+		if (f) {
+			while (fgets(line, sizeof line, f)) {
+				t = strtok(line, " \n");
+				if (t && trigname && strstr(trigname, t)) {
+					while ((t = strtok(0, " \n")) && ntrig < 16)
+						trigs[ntrig++] = atoi(t);
+				}
+			}
+			fclose(f);
+		}
+	}
+	for (i = 0; i < ntrig; i++)
+		if (trigs[i] == ordn) {
+			optim(cursub, cursec);
+			for (k = 2; k < stoff; ) {
+				sp = stabp(k);
+				if (sp->s_type == 1 && (sp->s_7 & 1) == 1)
+					sp->s_0 = 0;
+				if ((sp->s_7 & 6) == 6 || (sp->s_7 & 8) == 8)
+					k += 16;
+				else
+					k += 10;
+			}
+		}
+	ordn++;
+}
