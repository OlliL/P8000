+#ifdef VETO
+static int vlist[64], vn = -1, vf;
+int
+vetoed(type, lab)
+int type, lab;
+{
+	register int i, k;
+	FILE *f;
+
+	if (vn < 0) {
+		vn = 0;
+		vf = -2;
+		if ((f = fopen("/tmp/veto.txt", "r")) != NULL) {
+			register int c, v, any, first;
+
+			first = 1;
+			v = 0;
+			any = 0;
+			for (;;) {
+				c = getc(f);
+				if (c >= '0' && c <= '9') {
+					v = v * 10 + c - '0';
+					any = 1;
+					continue;
+				}
+				if (any) {
+					if (first) {
+						vf = v;
+						first = 0;
+					} else if (vn < 64)
+						vlist[vn++] = v;
+				}
+				v = 0;
+				any = 0;
+				if (c == EOF)
+					break;
+			}
+			fclose(f);
+		}
+	}
+	k = vevent++;
+	if ((f = fopen("/tmp/veto.log", "a")) != NULL) {
+		fprintf(f, "%d %d %c %d\n", vfidx, k, type, lab);
+		fclose(f);
+	}
+	if (vfidx != vf)
+		return 0;
+	for (i = 0; i < vn; i++)
+		if (vlist[i] == k)
+			return 1;
+	return 0;
+}
