.TH HYPOT 3M 
.\" @[$]hypot.3 1.2
.ad
.fi
.SH NAME
hypot, cabs \- Euklidischer Abstand
.SH SYNTAX
.nf
\fB#include <math.h>
.PP
\fBdouble hypot\fI(x, y)\fR
\fBdouble\fI x, y;\fR
.PP
\fBdouble cabs\fI(z)\fR
\fBstruct \fI{\fB double\fI x, y;} z;\fR
.fi
.SH BESCHREIBUNG
Die Funktionen
.B hypot
und
.B cabs
berechnen den Wert von
.IP
sqrt(x*x + y*y) .
.PP
.SH SIEHE AUCH
exp(3).
