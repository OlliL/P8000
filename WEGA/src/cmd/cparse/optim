# define SWAP(p,q) {sp=p; p=q; q=sp;}
# define RCON(p) (p->right->op==ICON)
# define RO(p) p->right->op
# define RV(p) p->right->lval
# define LCON(p) (p->left->op==ICON)
# define LO(p) p->left->op
# define LV(p) p->left->lval



extern short revrel[];

NODE *
fortarg( p ) register NODE *p; {
	/* fortran function arguments */

	if( p->op == CM ){
		p->left = fortarg( p->left );
		p->right = fortarg( p->right );
		return(p);
		}

	while( ISPTR(p->type) ){
		p = buildtree( UNARY MUL, p, NIL );
		}
	return( optim(p) );
	}

NODE *
optim(p) register NODE *p; {
	/* local optimizations, most of which are probably machine independent */

	register o, ty;
	register NODE *a, *b;
	int i;
	NODE *sp;
	TWORD t;

	if( (t=BTYPE(p->type))==ENUMTY || t==MOETY ) econvert(p);
	ty = optype( o=p->op);
	if( ty == LTYPE ) return(p);

	if( ty == BITYPE ) p->right = optim(p->right);
	p->left = optim(p->left);

	/* collect constants */

	switch(o){

	case SCONV:
	case PCONV:
		return( clocal(p) );

	case FORTCALL:
		p->right = fortarg( p->right );
		break;

	case UNARY MUL:
		if( LO(p) != ICON ) break;
		LO(p) = NAME;

		/* paint over the type of the left hand side with the type of the top */
		p->left->type = p->type;
		p->left->cdim = p->cdim;
		p->left->csiz = p->csiz;
		p->op = FREE;
		return( p->left );

	case MINUS:
		/* WEGA: (x+a)-(x+b) is a-b, (x-a)-(x-b) is b-a, x-x is 0 */
		if( LO(p) == PLUS && RO(p) == PLUS && treeeq( p->left->left, p->right->left ) &&
				p->left->right->type == p->type && p->right->right->type == p->type ){
			a = tcopy( p->left->right );
			b = tcopy( p->right->right );
			goto rebuild;
			}
		while( LO(p) == MINUS && RO(p) == MINUS && treeeq( p->left->left, p->right->left ) &&
				p->left->right->type == p->type && p->right->right->type == p->type ){
			b = tcopy( p->left->right );
			a = tcopy( p->right->right );
		rebuild:
			tfree( p->left );
			tfree( p->right );
			p->left = a;
			p->right = b;
			p = clocal( p );
			}
		if( treeeq( p->left, p->right ) && p->type != FLOAT && p->type != DOUBLE ){
			tfree( p->left );
			tfree( p->right );
			p->op = ICON;
			p->rval = NONAME;
			p->lval = 0;
			p = clocal( p );
			break;
			}
		if( !nncon(p->right) ) break;
		RV(p) = -RV(p);
		o = p->op = PLUS;

	case MUL:
	case PLUS:
	case AND:
	case OR:
	case ER:
		/* commutative ops; for now, just collect constants */
		/* someday, do it right */
		if( nncon(p->left) || ( LCON(p) && !RCON(p) && !( RO(p) == REG && p->right->rval == 15 ) &&
				!ISPTR(p->type) ) ) SWAP( p->left, p->right );
		if( (o == MINUS || o == PLUS) && nncon(p->right) && RV(p) == 0 ) goto zapright;
		/* make ops tower to the left, not the right */
		if( RO(p) == o && !ISPTR(p->type) && !ISPTR(p->right->left->type) ){
			NODE *t1, *t2, *t3;
			t1 = p->left;
			sp = p->right;
			t2 = sp->left;
			t3 = sp->right;
			/* now, put together again */
			p->left = sp;
			sp->left = t1;
			sp->right = t2;
			p->right = t3;
			}
		if(o == PLUS && LO(p) == MINUS && RCON(p) && RCON(p->left) &&
		  conval(p->right, MINUS, p->left->right)) goto zapleft;
		while( RCON(p) && LO(p)==o && RCON(p->left) && conval( p->right, o, p->left->right ) ){
			zapleft:
			RO(p->left) = FREE;
			LO(p) = FREE;
			p->left = p->left->left;
			}
		if( ISPTR(p->type) && LCON(p) && RO(p) == o && RCON(p->right) && conval( p->left, o, p->right->right ) ){
			p->right->right->op = FREE;
			RO(p) = FREE;
			p->right = p->right->left;
			}
		else if( LCON(p) && RCON(p) && conval( p->left, o, p->right ) ) goto zapright;

		/* change muls to shifts */

		if( o==MUL && nncon(p->right) && (i=ispow2(RV(p)))>=0){
			if( i == 0 ){ /* multiplication by 1 */
				goto zapright;
				}
			o = LS;
			p->right->type = p->right->csiz = INT;
			RV(p) = i;
			p->op = FREE;
			p = buildtree( o, p->left, p->right );
			}

		/* change +'s of negative consts back to - */
		if( o==PLUS && nncon(p->right) && RV(p)<0 ){
			RV(p) = -RV(p);
			o = p->op = MINUS;
			}
		break;

	zapright:
		RO(p) = FREE;
		p->left = makety( p->left, p->type, p->cdim, p->csiz );
		p->op = FREE;
		return( clocal( p->left ) );

	case DIV:
		if( nncon( p->right ) && p->right->lval == 1 ) goto zapright;
	case ASG DIV:
	case MOD:
	case ASG MOD:	/* WEGA: unsigned by a power of 2 as a shift or an and */
		a = p->right;
		if( ISUNSIGNED(p->type) && nncon(a) && ispow2(a->lval) > 0 ){
			if( o == MOD || o == ASG MOD ){
				p->op = (o == ASG MOD) ? ASG AND : AND;
				a->lval -= 1;
				a->type = p->type = p->left->type;
				}
			else {
				p->op = (o == ASG DIV) ? ASG RS : RS;
				a->lval = ispow2( a->lval );
				if( p->op == RS && p->left->type != p->type )
					p->left = makety( p->left, p->type, p->cdim, p->csiz );
				}
			}
		break;

	case ASG PLUS:
	case ASG MINUS:
		if( nncon(p->right) && RV(p) == 0 ) goto zapright;
		break;

	case EQ:
	case NE:
	case LT:
	case LE:
	case GT:
	case GE:
	case ULT:
	case ULE:
	case UGT:
	case UGE:
		if( !LCON(p) ) break;

		/* exchange operands */

		sp = p->left;
		p->left = p->right;
		p->right = sp;
		p->op = revrel[p->op - EQ ];
		break;

		}

	return(p);
	}

conval( p, o, q ) register NODE *p, *q; {
	/* apply the op o to the lval part of p; if binary, rhs is val */
	int i, u;
	CONSZ val;

	val = q->lval;
	u = ISUNSIGNED(p->type) || ISUNSIGNED(q->type);
	if( u && (o==LE||o==LT||o==GE||o==GT)) o += (UGE-GE);

	if( !nncon(p) && !nncon(q) ) return(0);
	if( !nncon(q) && o!=PLUS ) return(0);
	if( !nncon(p) && o!=PLUS && o!=MINUS ) return(0);

	switch( o ){

	case PLUS:
		p->lval += val;
		if( nncon(p) ){
			p->rval = q->rval;
			p->type = q->type;
			}
		break;
	case MINUS:
		p->lval -= val;
		break;
	case MUL:
		p->lval *= val;
		break;
	case DIV:
		if( val == 0 ) uerror( "division by 0" );
		else p->lval /= val;
		break;
	case MOD:
		if( val == 0 ) uerror( "division by 0" );
		else p->lval %= val;
		break;
	case AND:
		p->lval &= val;
		break;
	case OR:
		p->lval |= val;
		break;
	case ER:
		p->lval ^=  val;
		break;
	case LS:
		i = val;
		p->lval = p->lval << i;
		break;
	case RS:
		i = val;
		p->lval = p->lval >> i;
		break;

	case UNARY MINUS:
		p->lval = - p->lval;
		break;
	case COMPL:
		p->lval = ~p->lval;
		break;
	case NOT:
		p->lval = !p->lval;
		break;
	case LT:
		p->lval = p->lval < val;
		break;
	case LE:
		p->lval = p->lval <= val;
		break;
	case GT:
		p->lval = p->lval > val;
		break;
	case GE:
		p->lval = p->lval >= val;
		break;
	case ULT:
		p->lval = (p->lval-val)<0;
		break;
	case ULE:
		p->lval = (p->lval-val)<=0;
		break;
	case UGE:
		p->lval = (p->lval-val)>=0;
		break;
	case UGT:
		p->lval = (p->lval-val)>0;
		break;
	case EQ:
		p->lval = p->lval == val;
		break;
	case NE:
		p->lval = p->lval != val;
		break;
	default:
		return(0);
		}
	return(1);
	}

treeeq( p, q ) register NODE *p, *q; { /* are the trees p and q equal */
	register o;

	if( (o = p->op) != q->op ) return( 0 );
	switch( optype(o) ){

	case LTYPE:
		if( p->lval == q->lval && p->rval == q->rval ) return( 1 );
		return( 0 );

	case BITYPE:
		if( !treeeq( p->right, q->right ) ) return( 0 );
	case UTYPE:
		return( treeeq( p->left, q->left ) );
		}
	}

NODE *
rmconv( p, c ) register NODE *p; char c; { /* drop a conversion that changes nothing: c 'r' of the right side, 'l' of the left side, else of p */
	register NODE *q, *r;

	if( c == 'r' ){
		q = p->right;
		if( q->left->type == q->type || ( bsize( q->type ) == bsize( q->left->type ) &&
				!( notflt( q->type ) ^ notflt( q->left->type ) ) ) ||
				( q->type == DOUBLE && q->left->type == FLOAT ) ){
			r = tcopy( q->left );
			tfree( q );
			p->right = r;
			}
		}
	else if( c == 'l' ){
		q = p->left;
		if( q->left->type == q->type || ( bsize( q->type ) == bsize( q->left->type ) &&
				!( notflt( q->type ) ^ notflt( q->left->type ) ) ) ||
				( q->type == DOUBLE && q->left->type == FLOAT ) ){
			r = tcopy( q->left );
			tfree( q );
			p->left = r;
			}
		}
	else if( p->type == UNDEF ){
		r = tcopy( p->left );
		tfree( p );
		p = r;
		}
	return( p );
	}

notflt( t ) register TWORD t; { /* is t not a floating type */
	return( t == FLOAT || t == DOUBLE ? 0 : 1 );
	}
