tbytes( t ) TWORD t; { /* the size of a scalar type in bytes, at most 4 */
	switch( t ){
	case LONG:
	case ULONG:
		return( 4 );
	case CHAR:
	case UCHAR:
		return( 1 );
	case SHORT:
	case USHORT:
		return( 2 );
		}
	if( ISPTR(t) ) return( 2 );
	return( 2 );
	}

