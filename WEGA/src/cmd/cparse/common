bsize( t ) register t; { /* the size of a scalar type in bits */
	switch( t ){
	case CHAR:
	case UCHAR:
		return( 8 );
	case INT:
	case UNSIGNED:
		return( 16 );
	case LONG:
	case FLOAT:
	case ULONG:
		return( 32 );
	case DOUBLE:
		return( 64 );
		}
	if( ISPTR(t) ) return( 16 );
	cerror( "illegal bsize type: %%%0.2x\n", t );
	}

twords( t ) TWORD t; { /* the size of a scalar type in words */
	switch( t ){
	case LONG:
	case FLOAT:
	case ULONG:
		return( 2 );
	case DOUBLE:
		return( 4 );
	case INT:
	case ENUMTY:
	case UNSIGNED:
		return( 1 );
		}
	if( ISPTR(t) ) return( 1 );
	return( 1 );
	}

argsize( p ) register NODE *p; { /* the size of an argument in words */
	int s1, s2;

	if( p->op == STARG )
		return( (tsize( STRTY, p->left->cdim, p->left->csiz ) + 7) / SZINT );
	return( s2 = s1 = twords( p->type == FLOAT ? DOUBLE : p->type ) );
	}

