ncopy( q, p ) NODE *p, *q; {
	/* copy the contents of p into q, without any feeling for
	   the contents */
	*q = *p;
	}

NODE *
tcopy( p ) register NODE *p; {
	/* make a fresh copy of p */

	register NODE *q;

	q = talloc();
	ncopy( q, p );

	switch( optype(q->op) ){

	case BITYPE:
		q->right = tcopy(p->right);
	case UTYPE:
		q->left = tcopy(p->left);
		}

	return(q);
	}

ispow2( c ) register CONSZ c; {
	register i;
	if( c <= 0 || (c&(c-1)) ) return(-1);
	for( i=0; c>1; c >>= 1) ++i;
	return(i);
	}

nncon( p ) register NODE *p; {
	/* is p a constant without a name */
	return( p->op == ICON && p->rval == NONAME );
	}

static int memfirst = 1;

char *
getmem( n ) register n; { /* n bytes of memory, from a hunk of at least 2000 bytes */
	register char *p;
	int incr;

	if( memfirst ){
		memfirst = 0;
		memcur = memtop = (char *) sbrk( 0 );
		}
	n = (n+1) & ~1;
	if( memcur + n >= memtop ){
		if( n > 2000 ) incr = n;
		else incr = 2000;
		if( sbrk( incr ) == -1 ) cerror( "Code generator: out of space\n" );
		memtop += incr;
		}
	p = memcur;
	memcur += n;
	return( p );
	}
