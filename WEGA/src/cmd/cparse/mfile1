struct symtab {	/* WEGA: 26 bytes from malloc, in hash chains linked by the xor of the two neighbours */
	struct symtab *slink;	/* xor of the previous and the next entry of the chain */
	int sname;	/* offset of the name in ntab */
	TWORD stype;  /* type word */

	char sclass;  /* storage class */
	char slevel;  /* scope level */
	int sfld8;	/* (use open) */
	char sflags;  /* flags for set, use, hidden, mos, etc. */
	char sfldb;	/* (use open) */
	char sfldc;	/* (use open) */
	OFFSZ offset;  /* offset or value */
	short dimoff; /* offset into the dimension table */
	short sizoff; /* offset into the size table */
	short suse;  /* line number of last use of the variable */
	short symno;	/* number of the symbol in the .S file */
	};


