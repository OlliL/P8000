#	macros crunch procedure
#	(System III 1.17, changed for WEGA: see below)
#
# SCCS: @(#)macrunch	1.17

move=n
roff=
pname=
name=
path=/usr


if [ $# -lt 1 ]
	then echo usage: macrunch [-m] [-d path] [{-n _o_r -t} "package name"] ".src name" 
	exit 1
fi

while [ $# -gt 0 ]
do
    case $1 in

	-m)	move=y;;
	-n)	roff=n; pname=$2; shift;;
	-t)	roff=t; pname=$2; shift;;
	-d)	path=$2; shift;;
	*)	name=$1;;

    esac
    shift
done

# WEGA: the packages of the WEGA root are the .src files with their lines as they are (mmt, vmca), the nroff package (-n) without its comment
# lines and without the comments at the end of a line. System III's sed (compaction of blanks, <<name>>, @) and ntar (the NOCOMPACT part,
# nroff -k) are not used: the files of the WEGA root show nothing of them.
case ${roff} in
n)	sed -e "/^''*\\\\\"/d" -e 's/\\".*//' ${name}.src > ${name} ;;
*)	cat ${name}.src > ${name} ;;
esac

if [ $move = "y" ] 
then
	cp ${name} ${path}/lib/macros
	chmod 644 ${path}/lib/macros/${name}
	if [ "${path}" = "/usr" ]
	    then chown bin ${path}/lib/macros/${name}
	         chgrp bin ${path}/lib/macros/${name}
	    else true
	fi
	rm -f ${name}
fi
