# yacc: the parser skeleton of yacc (/usr/lib/yaccpar): System III's yacc.mk copies it (INS -n /usr/lib yaccpar); the file is the one of the WEGA root. The program yacc is not here yet.
#
#   make install PREFIX=dir    install below dir/ (the modes of the WEGA root)

PREFIX = /

all:

install:
	mkdir -p $(PREFIX)/usr/lib
	rm -f $(PREFIX)/usr/lib/yaccpar ; cp yaccpar $(PREFIX)/usr/lib/yaccpar ; chmod 644 $(PREFIX)/usr/lib/yaccpar

clean:

.PHONY: all install clean
