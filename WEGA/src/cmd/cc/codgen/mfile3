#define TSAME	0x4000		/* both operands of the same type */
#define TFIT	0x8000		/* both operands of the same size */

/* the SPECIAL shapes (local3.c special): SSCON and SICON are the names prcook prints, SCONSET and SCONRES those of
   Plexus mac2defs (one bit set, one bit clear), the others are guessed */
#define SKCON	(SPECIAL|1)	/* a constant 0 .. 15 */
#define SSCON	(SPECIAL|2)	/* a constant -16 .. 16 */
#define SBCON	(SPECIAL|3)	/* a constant -256 .. 255 */
#define SICON	(SPECIAL|4)	/* a constant -32768 .. 32767 */
#define SINCON	(SPECIAL|5)	/* the same, and nncon */
#define SCONSET	(SPECIAL|6)	/* a power of two */
#define SCONRES	(SPECIAL|7)	/* the complement a power of two */
#define SADCON	(SPECIAL|8)	/* a constant with a name (an address) */

/* the cookie of a rewrite rule and the answers of match */
#define FORREW	0x4000
#define NOMATCH	0x1000
#define MDONE	0x1001

/* the operator classes of the table (op 0x1000 + 2k, ASG: + 1; the order of ocnames and opclass of match3.c) */
#define OPSIMP	0x1000
#define OPCOMM	0x1002
#define OPMUL	0x1004
#define OPDIV	0x1006
#define OPUNARY	0x1008
#define OPLEAF	0x100a
#define OPANY	0x100c
#define OPLOG	0x100e
#define OPLONG	0x1010
#define OPSHFT	0x1012
#define OPBIT	0x1014
#define OPFLOAT	0x1016
#define OPLTYPE	0x1018

/* needs: registers (A: bits 0-3, B: 4-7), temporaries of the frame (8-9) and of the parameter area (10-11) */
#define NAREG	01
#define NACOUNT	03
#define NAMASK	017
#define NASL	04		/* share left register */
#define NASR	010		/* share right register */
#define NBREG	020
#define NBCOUNT	060
#define NBMASK	0360
#define NBSL	0100
#define NBSR	0200
#define NTEMP	0400
#define NTMASK	01400		/* WEGA: two bits (the PCC has 07400) */
#define NPTEMP	02000		/* a temporary of the parameter area (name guessed) */
#define NPTMASK	06000
#define REWRITE	0x1000		/* in q->needs: the entry only rewrites the tree, q->rewrite is the answer */

/* rewrite: what the tree becomes */
#define RNULL	0
#define RLEFT	01
#define RRIGHT	02
#define RESC1	04
#define RESC2	010
#define RESC3	020
#define RESC	02000		/* rewrite & 0x400: the second register of a long result */
#define RESCC	04000
#define RNOP	010000

/* register classes of struct rs (the names are guessed; the numbers are measured from rclass, roverlap, rsreturn):
   a byte, a word, a pair (long, segmented pointer), a float register; 5..8 the same as register variables (5 is never made); RCANY only for rsreturn */
#define RCBYTE	1
#define RCWORD	2
#define RCPAIR	3
#define RCFLOAT	4
#define RCVBYTE	5
#define RCVWORD	6
#define RCVPAIR	7
#define RCVFLOAT	8
#define RCANY	9

/* an OREG with a base and an index register (the names as SysIII mfile2): rval = ((base + 1) << 8) | (index + 1), index + 1 == 0: no index */
#define R2TEST(x)	((x) >= 0x100)
#define R2PACK(x, y)	((((x) + 1) << 8) | ((y) + 1))
#define R2BASE(x)	(((x) + 1) << 8)
#define R2UPK1(x)	(((x) >> 8) - 1)
#define R2UPK2(x)	(((x) & 0xFF) - 1)

#define isbreg(r)	(rstatus[r] & SBREG)	/* as PCC mfile2 */
#define istreg(r)	(rstatus[r] & (STBREG|STAREG))	/* as PCC mfile2 */
#define BITMASK(n)	((1L << n) - 1)	/* the low n bits (as PCC local2.c) */

/* the words a temporary for the result of p needs (macros in the original: expanded twice in allo); a parameter
   temporary of a float takes a double */
#define STRWORDS(p)	((unsigned)(SZCHAR * p->stn.stsize + (SZINT - 1)) / SZINT)
#define ISSTOP(p)	(p->in.op == STCALL || p->in.op == STARG || p->in.op == UNARY STCALL || p->in.op == STASG)
#define TEMPWORDS(p, nfield) \
	(ISSTOP(p) ? STRWORDS(p) : (p->in.type == LONG || p->in.type == ULONG) ? SZLONG / SZINT : \
	 ISPTR(p->in.type) ? SZPOINT / SZINT : p->in.type == DOUBLE ? SZDOUBLE / SZINT : p->in.type == FLOAT ? SZFLOAT / SZINT : (nfield))
#define PARMWORDS(p, nfield) \
	(ISSTOP(p) ? STRWORDS(p) : (p->in.type == LONG || p->in.type == ULONG) ? SZLONG / SZINT : \
	 ISPTR(p->in.type) ? SZPOINT / SZINT : p->in.type == DOUBLE ? SZDOUBLE / SZINT : p->in.type == FLOAT ? SZDOUBLE / SZINT : (nfield))

#define MUSTDO	010000
#define NOPREF	020000

union ndu {
	struct {
		int	op;
		int	rall;		/* register preference, NOPREF when none */
		TWORD	type;
		char	su;		/* 6: registers the subtree needs (word registers) */
		char	fsu;		/* 7: float registers the subtree needs */
		struct sym *sname;	/* 8: symbol of a NAME or ICON; non-zero: the constant has a name; the label of a compare */
		int	stsize;		/* 0xA: STASG size, TEMP number */
		int	hi;		/* 0xC: the high word of lval; STASG alignment */
		NODE	*left;		/* 0xE: overlays the low word of lval */
		NODE	*right;		/* 0x10: overlays rval */
	}in;				/* interior node */
	struct {
		int	op;
		int	rall;
		TWORD	type;
		char	su;
		char	fsu;
		struct sym *sname;
		int	stsize;
		long	lval;		/* 0xC: the value of a leaf */
		int	rval;		/* 0x10: the register, the tag */
	}tn;				/* terminal node */
	struct {
		int	op;
		int	rall;
		TWORD	type;
		char	su;
		char	fsu;
		int	label;		/* 8: for use with branching */
	}bn;				/* branch node */
	struct {
		int	op;
		int	rall;
		TWORD	type;
		char	su;
		char	fsu;
		struct sym *sname;
		int	stsize;		/* sizes of structure objects */
		int	stalign;	/* alignment of structure objects */
	}stn;				/* structure node */
};

