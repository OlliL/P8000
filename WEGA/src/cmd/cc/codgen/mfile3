union ndu {
	struct {
		int	op;
		int	rall;		/* register preference, NOPREF when none */
		TWORD	type;
		char	su;		/* 6: registers the subtree needs (word registers) */
		char	fsu;		/* 7: float registers the subtree needs */
		struct sym *sname;	/* 8: symbol of a NAME or ICON; non-zero: the constant has a name; the label of a compare */
		int	stsize;		/* 0xA: STASG size, TEMP number */
		int	hi;		/* 0xC: the high word of lval; STASG alignment */
		NODE	*left;		/* 0xE: overlays the low word of lval */
		NODE	*right;		/* 0x10: overlays rval */
	}in;				/* interior node */
	struct {
		int	op;
		int	rall;
		TWORD	type;
		char	su;
		char	fsu;
		struct sym *sname;
		int	stsize;
		long	lval;		/* 0xC: the value of a leaf */
		int	rval;		/* 0x10: the register, the tag */
	}tn;				/* terminal node */
	struct {
		int	op;
		int	rall;
		TWORD	type;
		char	su;
		char	fsu;
		int	label;		/* 8: for use with branching */
	}bn;				/* branch node */
	struct {
		int	op;
		int	rall;
		TWORD	type;
		char	su;
		char	fsu;
		struct sym *sname;
		int	stsize;		/* sizes of structure objects */
		int	stalign;	/* alignment of structure objects */
	}stn;				/* structure node */
};

extern char ascii[];		/* the ascii table (names of the symbols) */
extern struct sym *fpsym1, *fpsym2;	/* the pseudo symbols ~L1 and ~L2 of the frame */

struct rs {
	char reg;	/* register number (byte registers 0..15, word registers 0..15, long registers even) */
	char cls;
	char kind;	/* 8: holds a symbol */
	char busy;	/* use count */
	long	off;		/* frame offset of the symbol it holds */
	int	flags;		/* bit 15: ... */
	struct rs *next;
	struct sym *sym;
};
extern int fregs, ffregs;	/* 0x8f8a, 0x8f88: the number of word and float registers (8, 4) */
extern struct rs *rsfree, *rsuse, *rspool;

struct optab {
	int	op;
	int	visit;
	int	lshape;
	int	ltype;
	int	rshape;
	int	rtype;
	int	needs;		/* registers needed (counts in nibbles), 0x1000: the entry only rewrites the tree */
	int	nx;		/* 0xE: not used by match(); small flags (1, 2, 5, 0xd ...), meaning not yet known */
	int	rewrite;	/* 0x10: RLEFT, RRIGHT, RESC1 ... */
	char	*cstring;
};
