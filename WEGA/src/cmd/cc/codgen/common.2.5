static char *endbrk, *curbrk;	/* 0x4060, 0x405e */
static int firstalloc = 1;	/* 0x4062 */

/* memory from the system in steps of at most 2000 bytes, never freed */
char *
getmem(n)
	register int n;
{
	register char *p;
	int step;

	if (firstalloc) {
		firstalloc = 0;
		curbrk = endbrk = sbrk(0);
	}
	n++;
	n &= ~1;
	if (curbrk + n >= endbrk) {
		if (n > 2000)
			step = n;
		else
			step = 2000;
		if ((int)sbrk(step) == -1)
			cerror("Code generator: out of space\n");
		endbrk += step;
	}
	p = curbrk;
	curbrk += n;
	return p;
}

void
allocinit(base)
	char *base;
{
	brk(base);
	curbrk = endbrk = base;
	endbrk--;
}

