/* an error in the source program */
void
syserr(s)
	char *s;
{
	fprintf(stderr, "system call error: ");
	perror(s);
	dexit(0x40);
}

void
uerror(s, a)
	char *s;
	int a;
{
	++nerrors;
	where('u');
	fprintf(stderr, s, a);
	fprintf(stderr, "\n");
	if (nerrors > NERRMAX)
		cerror("too many errors");
}

/* an error of the compiler itself: the program stops */
int
cerror(s, a, b, c)
	char *s;
{
	where('c');
	if (nerrors && nerrors <= NERRMAX)
		fprintf(stderr, "cannot recover from earlier errors\n");
	else {
		fprintf(stderr, "compiler error: ");
		fprintf(stderr, s, a, b, c);
		putc('\n', stderr);
	}
	dexit(0x40);
}

void
werror(s, a, b)
	char *s;
{
	where('w');
	fprintf(stderr, "warning: ");
	fprintf(stderr, s, a, b);
	fprintf(stderr, "\n");
}

/* all nodes are free */
void
tinit()
{
	NODE *p;

	for (p = node; p <= &node[TREESZ - 1]; p++)
		p->in.op = FREE;
	lastfree = node;
}

/* a free node from the pool, searching on from the last one */
NODE *
talloc()
{
	NODE *p, *start;
	int x;

	start = lastfree;
	p = start == &node[TREESZ - 1] ? node : start + 1;
	while (p != start) {
		if (p->in.op == FREE) {
			p->in.sname = 0;
			return lastfree = p;
		}
		p = p == &node[TREESZ - 1] ? node : p + 1;
	}
	cerror("out of tree space; simplify expression");
}

/* after the function: every node is free again, otherwise say which are not */
void
tcheck()
{
	NODE *p;

	if (!nerrors)
		for (p = node; p <= &node[TREESZ - 1]; p++)
			if (p->in.op != FREE)
				cerror("wasted space: %%%x(%d)", p, p->in.op);
	tinit();
}

void
tfree(p)
	NODE *p;
{
	if (p->in.op != FREE)
		walkf(p, tfree1);
}

static void
tfree1(p)
	NODE *p;
{
	if (p == 0)
		cerror("freeing blank tree!");
	else
		p->in.op = FREE;
}

/* walk the tree before the operands, with the value passed down: f(p, down, &down1, &down2) */
void
fwalk(p, f, down)
	register NODE *p;
	int (*f)();
	int down;
{
	int down1, down2;

again:
	down1 = down2 = 0;
	(*f)(p, down, &down1, &down2);
	switch optype(p->in.op) {
	case BITYPE:
		fwalk(p->in.left, f, down1);
		p = p->in.right;
		down = down2;
		goto again;
	case UTYPE:
		p = p->in.left;
		down = down1;
		goto again;
	}
}

/* walk the tree after the operands */
void
walkf(p, f)
	register NODE *p;
	int (*f)();
{
	register int kind;

	if (p == 0)
		return;
	kind = optype(p->in.op);
	if (kind != LTYPE)
		walkf(p->in.left, f);
	if (kind == BITYPE)
		walkf(p->in.right, f);
	(*f)(p);
}

