# codgen, scodgen: the code generators (second pass of cc and scc), reconstructed from /lib/codgen and /lib/scodgen. The same sources
# make both: scodgen is codgen compiled with -DSEG and the tables table3_scodgen.c, ops_scodgen.c, hop_scodgen.c (generated by
# host/tools/codgentab.py from the original binaries). Both are non-segmented programs; the objects of scodgen go to seg/.
# Byte-identical with the originals.
#
#   make              codgen scodgen
#   make oldprep      what the versions of the old compiler need of this directory (crt0)
#   make old          the versions of the old compiler in OLDDIRS (v1/Makefile ...)
#   make clean

CC = ccv0p
CAS = cas
LD = ld
CFLAGS = -O
LIBC = ../../lib/libc-v5.a
CRT = ../../lib/libc/crt
SRCS = bss3.c reader3.c rdr3.c local3.c order3.c match3.c allo3.c regallo3.c comm3.c wrt3.c regs3.c lcl3.c tr3.c optim3.c
OBJS = bss3.o reader3.o rdr3.o local3.o order3.o match3.o allo3.o regallo3.o comm3.o table3_codgen.o wrt3.o regs3.o lcl3.o tr3.o optim3.o
SOBJS = seg/bss3.o seg/reader3.o seg/rdr3.o seg/local3.o seg/order3.o seg/match3.o seg/allo3.o seg/regallo3.o seg/comm3.o seg/table3_scodgen.o seg/wrt3.o seg/regs3.o seg/lcl3.o seg/tr3.o seg/optim3.o

# the versions of the old compiler (one directory each, own Makefile; not part of all)
OLDDIRS = v1 v0 v0p

all: codgen scodgen

oldprep: $(CRT)/crt0-codgen.o

old: oldprep
	for d in $(OLDDIRS); do cd $$d ; $(MAKE) ; cd .. ; done

codgen: $(OBJS) $(CRT)/crt0-codgen.o
	$(LD) -X -e start -i $(CRT)/crt0-codgen.o $(OBJS) $(LIBC) -o codgen

$(OBJS) table3_codgen.o: cg.h cg2.h

local3.o: hop_codgen.c

comm3.o: ops_codgen.c

scodgen: $(SRCS) table3_scodgen.c cg.h cg2.h $(CRT)/crt0-codgen.o
	-mkdir seg
	for f in $(SRCS) table3_scodgen.c ; do ( cd seg ; $(CC) $(CFLAGS) -DSEG -c ../$$f ) || exit 1 ; done
	$(LD) -X -e start -i $(CRT)/crt0-codgen.o $(SOBJS) $(LIBC) -o scodgen

$(CRT)/crt0-codgen.s: $(CRT)/crt0.s.in $(CRT)/crt0.list $(CRT)/mkcrt0.sh
	sh $(CRT)/mkcrt0.sh codgen > $@

$(CRT)/crt0-codgen.o: $(CRT)/crt0-codgen.s
	$(CAS) -u -o $@ $(CRT)/crt0-codgen.s

clean:
	rm -f *.o codgen scodgen
	rm -rf seg

.PHONY: all oldprep old clean
