# codgen, scodgen: the code generators (second pass of cc and scc), reconstructed from /lib/codgen and
# /lib/scodgen. The same sources make both: scodgen is compiled with scc and the tables table3_scodgen.c,
# ops_scodgen.c, hop_scodgen.c (generated by host/tools/codgentab.py from the original binaries).
# Work in progress: the engine is not complete yet (see README), so there is no program to build yet.
#
#   make check WEGA=dir   compare the modules with the original (not yet)
#   make clean

CC = cc
SCC = scc
CFLAGS = -O
OBJS = allo3.o local3.o match3.o order3.o out3.o regallo3.o regfile3.o tmp3.o

all: objs

objs: $(OBJS) table3_codgen.o ops_codgen.o hop_codgen.o

$(OBJS) table3_codgen.o ops_codgen.o hop_codgen.o: cg.h

clean:
	rm -f *.o

.PHONY: all objs clean
