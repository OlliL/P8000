# fse: the documentation of the full screen editor (/usr/doc/fse.doc), the file of the WEGA root (no source in System III, Plexus or 4.4BSD).
# The program fse is not here yet.
#
#   make install PREFIX=dir    install below dir/usr/doc (mode 644)

PREFIX = /

all:

install:
	mkdir -p $(PREFIX)/usr/doc
	cp fse.doc $(PREFIX)/usr/doc/fse.doc ; chmod 644 $(PREFIX)/usr/doc/fse.doc

clean:

.PHONY: all install clean
